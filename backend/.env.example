# LFX Mentorship API — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit a .env file containing secrets.

# ─── HTTP Server ─────────────────────────────────────────────────────────────
PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Full PostgreSQL DSN. sslmode=disable for local dev only; require/verify-full in production.
DATABASE_DSN=postgres://mentorship:mentorship@localhost:5433/mentorship?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ─── Auth0 / JWT ─────────────────────────────────────────────────────────────
JWKS_URL=https://<your-auth0-domain>/.well-known/jwks.json
# Must exactly match the API identifier registered in Auth0 (no trailing slash).
JWT_AUDIENCE=https://<your-api-audience>
JWT_ISSUER=https://<your-auth0-domain>/
# Optional: override JWT clock-skew tolerance. Defaults to 5s.
# JWT_CLOCK_SKEW=5s

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=lfx-mentorship-backend
OTEL_SERVICE_VERSION=dev
# Leave empty to disable trace export (no-op tracer is used).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Local dev only ──────────────────────────────────────────────────────────
# Must be true to allow DISABLED_MOCK_LOCAL_PRINCIPAL. Keep false everywhere
# except isolated local development.
ALLOW_MOCK_LOCAL_PRINCIPAL_BYPASS=false
# Leave empty by default. Any non-empty value bypasses JWT validation and sets
# a static mock principal for local development only.
# NEVER enable in staging or production.
DISABLED_MOCK_LOCAL_PRINCIPAL=

# ─── Mentor invite token signing ─────────────────────────────────────────────
# Required. HMAC secret used to sign tokenised mentor invite links.
# Generate with: openssl rand -hex 32
MENTOR_INVITE_SECRET=replace-with-a-strong-random-secret
