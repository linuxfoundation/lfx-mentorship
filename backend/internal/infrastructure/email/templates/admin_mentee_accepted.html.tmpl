{{- /* Legacy: hr-mentee-accepted, without the special-recipient CCs. Only the HR copy carries the country of residence. */ -}}
{{template "header" .}}{{template "greeting" "Dear Program Admin and HR Team"}}<p><strong>{{.MenteeName}}</strong> has been accepted to the <strong>{{.ProgramName}}</strong> mentorship.</p>
<p>HR team, please generate the acceptance letter and contract paperwork with the following details:</p>
{{template "details_start"}}{{template "detail" (detail "Mentorship Program Name" .ProgramName)}}{{range .ProgramAdmins}}{{with .Name}}{{template "detail" (detail "Program Admin Name" .)}}{{end}}{{template "detail" (detail "Program Admin Email" .Email)}}{{end}}{{template "detail" (detail "Mentee Name" .MenteeName)}}{{with .MenteeEmail}}{{template "detail" (detail "Mentee Email" .)}}{{end}}{{with .TermStart}}{{template "detail" (detail "Mentorship Start Month and Year" .)}}{{end}}{{with .TermEnd}}{{template "detail" (detail "Mentorship End Month and Year" .)}}{{end}}{{with .AttendanceType}}{{template "detail" (detail "Attendance Status" .)}}{{end}}{{with .MenteeCountry}}{{template "detail" (detail "Mentee Country of Residence" .)}}{{end}}{{template "details_end"}}<p><strong>Program Admin</strong> you will be notified when mentee signs the acceptance letter.</p>
{{if .MenteeCountry}}<p><strong>NOTE:</strong> Please save the mentee country of residence for stipend amount verification.</p>
{{end}}{{template "button" .ManageURL}}Login To LFX Mentorship{{template "button_end"}}{{template "footer" .}}
