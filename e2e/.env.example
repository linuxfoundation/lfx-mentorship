# Copy to e2e/.env and fill in the passwords. .env is gitignored; never commit it.
# Leave a user's pair empty to skip that user: specs that need it are skipped, not failed.

E2E_SELF_SERVE_URL=https://app.dev.lfx.dev

# Program Admin A, approver, then Mentor 2
E2E_ADMIN_A_USERNAME=sameh100
E2E_ADMIN_A_PASSWORD=

# Approver, Program Admin B, Mentor 1
E2E_ADMIN_B_USERNAME=samehlol16
E2E_ADMIN_B_PASSWORD=

# Mentee 1, non-approver
E2E_MENTEE_1_USERNAME=sameh001
E2E_MENTEE_1_PASSWORD=

# Brand-new user, then mentee from an Apply link, then Mentee 2
E2E_MENTEE_2_USERNAME=samehhotmail
E2E_MENTEE_2_PASSWORD=
