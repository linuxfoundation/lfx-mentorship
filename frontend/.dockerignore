# Dependencies — installed fresh inside the image
node_modules/
.pnpm-store/

# Build artifacts — produced inside the image
.output/
.nuxt/
.nitro/
.cache/
dist/

# Local env files — never ship secrets into the image
.env
.env.*
!.env.example

# Dev tooling
.git/
.github/
charts/
*.md
# ...but the user docs ARE the product here: the portal reads this Markdown at runtime,
# and the search index is generated from it during the build.
!docs/user/**

# Test / coverage
coverage/
