# LFX Mentorship (menv3) — environment variables
# Copy this file to .env and fill in real values.

NUXT_PUBLIC_APP_ENV=development
# Public URL of this app. Prefer NUXT_PUBLIC_APP_URL so the value is re-read
# at server startup (same image, multiple environments).
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_APP_URL=http://localhost:3000
# Sitemap / site-config origin. Keep in sync with NUXT_PUBLIC_APP_URL so
# sitemap locs match canonical tags (read at runtime by @nuxtjs/sitemap).
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_API_BASE_URL=http://localhost:8080

# Crowdfunding app base URL — Donate links to `${url}/initiatives/{id}`
NUXT_PUBLIC_CROWDFUNDING_URL=https://crowdfunding.dev.lfx.dev

# Optional — used by header user menu + Intercom in footer
# NUXT_PUBLIC_SELF_SERVE_URL=https://app.dev.lfx.dev
# NUXT_PUBLIC_INTERCOM_APP_ID=
